            "planned",
            "running",
            "completed_unintegrated",
            "integrated",
            "failed_recoverable",
            "failed_terminal",
            "stalled"
          ]
        },
        "schema_version": "supervisor-state-v1",
        "supervisor_kind": "phase-driven"
      },
      "tool_policy": {},
      "workspace_bootstrap": {
        "resources": {
          "skills": {
            "project_dir": "skills",
            "source_dir": "skills",
            "user_dir": "${CODEX_HOME}/skills"
          }
        }
      }
    },
    "display_name": "Test Profile",
