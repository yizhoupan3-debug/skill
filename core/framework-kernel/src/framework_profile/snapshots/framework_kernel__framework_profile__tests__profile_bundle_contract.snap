    "capability_surface": {
      "approval_policy": {},
      "artifact_contract": {},
      "delegation_contract": {
        "artifact_id": "delegation_contract",
        "delegation_kind": "hierarchical",
        "delegations": {
          "console": {
            "tool_description": "Navigate to a specific file/line and run a task",
            "tool_name": "task"
          },
          "subagent_config": {
            "tool_description": "Spawn a sub-agent for a focused task",
            "tool_name": "subagent"
          }
        },
        "fallback": {
          "fallback_instructions": "complete sub-goal without spawning",
          "local_fallback": true
        },
        "schema_version": "delegation-v1",
        "spawning_policy": {
          "default_timeout_secs": 300,
          "max_sub_agents": 5,
          "rate_limit": {
            "max_spawns": 10,
            "window_secs": 60
          }
        }
      },
      "execution_controller_contract": {
        "artifact_id": "execution_controller_contract",
        "controller_kind": "event-driven-delegation",
        "event_driven": {
          "agent_idle_timeout_secs": 600,
          "dispatchers": [
            {
              "event": "task_idle",
              "handler": "task_timeout_handler"
            },
            {
              "event": "task_done",
              "handler": "task_completion_handler"
            },
            {
              "event": "sub_task_submitted",
              "handler": "sub_task_handler"
            },
            {
              "event": "supervisor_tick",
              "handler": "supervisor_tick_handler"
            }
          ]
        },
        "schema_version": "execution-controller-v1"
      },
      "execution_protocol_contract": {
        "artifact_id": "execution_protocol_contract",
        "genesis": {
          "engine": "skill-framework",
          "framework_profile_version": "0.1.0",
          "initial_state": "goal_acquisition",
          "seed_agent": "init",
          "seed_tool": "resolve"
        },
        "phases": [
          {
            "entry_message": "planning_contract",
            "phase_id": "resolve"
          },
          {
            "entry_message": "execution_contract",
            "phase_id": "execute"
          },
          {
            "entry_message": "verification_report",
            "phase_id": "verify"
          },
          {
            "entry_message": "closeout_record",
            "phase_id": "closeout"
          }
        ],
        "schema_version": "execution-protocol-v1",
        "termination": {
          "abnormal": "error_or_interrupt",
          "normal": "phase_complete"
        }
      },
      "framework_surface_policy": {},
      "loadout_policy": {},
      "mcp_servers": [],
      "session_contract": {
        "model_policy": {},
        "session_policy": {}
      },
      "supervisor_state_contract": {
        "artifact_id": "supervisor_state_contract",
        "schema_expectations": {
          "delegation_fields": [
            "delegation_plan_created",
            "spawn_attempted",
            "spawn_block_reason",
            "fallback_mode",
            "delegated_sidecars"
          ],
          "execution_contract_fields": [
            "goal",
            "scope",
            "forbidden_scope",
            "acceptance_criteria",
            "evidence_required"
          ],
          "top_level_fields": [
