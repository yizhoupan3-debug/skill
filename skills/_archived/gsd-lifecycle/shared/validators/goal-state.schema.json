{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSD Goal State",
  "description": "GOAL_STATE.json schema for GSD lifecycle management",
  "type": "object",
  "required": ["schema_version", "version", "goal", "created_at", "status", "done_criteria"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "gsd-goal-state-v1",
      "description": "Schema version identifier"
    },
    "version": {
      "type": "string",
      "const": "1.0",
      "description": "Content version"
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "description": "Project goal in one sentence"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "Creation timestamp"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Last update timestamp"
    },
    "status": {
      "type": "string",
      "enum": ["active", "paused", "completed", "aborted"],
      "description": "Current goal status"
    },
    "done_criteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "description", "verification_command"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "verification_command": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["pending", "verified", "failed"]
          },
          "evidence_ref": { "type": "string" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "properties": {
        "task_id": { "type": "string" },
        "owner": { "type": "string" },
        "phase": { "type": "string" },
        "wave": { "type": "integer" },
        "gsd_command": { "type": "string" }
      }
    }
  }
}
