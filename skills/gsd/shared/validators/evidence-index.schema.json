{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSD Evidence Index",
  "description": "EVIDENCE_INDEX.json schema for verification records",
  "type": "object",
  "required": ["schema_version", "version", "created_at", "entries"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "gsd-evidence-index-v1"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "task_id": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "timestamp", "command", "result", "phase"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^ev-[0-9]{8}-[0-9]{6}$"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "command": {
            "type": "string"
          },
          "result": {
            "type": "string",
            "enum": ["pass", "fail", "error", "skipped"]
          },
          "output_ref": {
            "type": "string"
          },
          "phase": {
            "type": "string",
            "enum": ["exploration", "planning", "execution", "verification", "shipping"]
          },
          "wave": {
            "type": "integer"
          },
          "agent": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
