{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GSD Wave State",
  "description": "WAVE_STATE.json schema for wave execution tracking",
  "type": "object",
  "required": ["schema_version", "version", "task_id", "waves"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "gsd-wave-state-v1"
    },
    "version": {
      "type": "string",
      "const": "1.0"
    },
    "task_id": {
      "type": "string"
    },
    "current_wave": {
      "type": "integer",
      "minimum": 1
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["wave_id", "phases", "status"],
        "properties": {
          "wave_id": {
            "type": "integer",
            "minimum": 1
          },
          "phases": {
            "type": "array",
            "items": { "type": "string" }
          },
          "status": {
            "type": "string",
            "enum": ["pending", "running", "completed", "failed", "skipped"]
          },
          "started_at": {
            "type": "string",
            "format": "date-time"
          },
          "completed_at": {
            "type": ["string", "null"],
            "format": "date-time"
          },
          "agents": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "status": { "type": "string" },
                "pid": { "type": "integer" }
              }
            }
          },
          "checkpoint": {
            "type": "object",
            "properties": {
              "last_checkpoint": { "type": "string" },
              "evidence_files": {
                "type": "array",
                "items": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "global_status": {
      "type": "string",
      "enum": ["running", "completed", "blocked", "failed"]
    }
  }
}
