{
  "schema_version": "framework-runtime-registry-v1",
  "framework_core": {
    "authority": "rust",
    "source": "framework-root-native",
    "host_policy": "closed-set-explicit-projections",
    "authority_priority": "rust-primary",
    "acceleration_policy": "prefer-rust-when-implemented"
  },
  "host_targets": {
    "policy": "shared-rust-core-explicit-host-projections",
    "supported": [
      "codex-cli",
      "codex-app",
      "cursor",
      "claude-code",
      "claude-desktop"
    ],
    "shared_system_source": "skills",
    "metadata": {
      "codex-cli": {
        "install_tool": "codex",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "gsd",
        "host_entrypoints": "AGENTS.md"
      },
      "cursor": {
        "install_tool": "cursor",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "gsd",
        "host_entrypoints": [
          "AGENTS.md",
          ".cursor/rules/*.mdc"
        ]
      },
      "codex-app": {
        "install_tool": "codex",
        "projection_status": "implemented",
        "installable": false,
        "unsupported_reason": "Codex app is runtime-supported through the desktop thread host; it does not install file projections.",
        "host_entrypoints": "AGENTS.md"
      },
      "claude-code": {
        "install_tool": "claude",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "gsd",
        "host_entrypoints": [
          "AGENTS.md",
          ".claude/rules/framework.md",
          ".claude/settings.json"
        ]
      },
      "claude-desktop": {
        "install_tool": "claude-desktop",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "gsd",
        "host_entrypoints": [
          "AGENTS.md",
          ".claude/CLAUDE.md"
        ]
      }
    }
  },
  "workspace_bootstrap_defaults": {
    "skills": {
      "source_rel": "skills",
      "project_dir": "skills",
      "user_dir": "${CODEX_HOME}/skills",
      "source_dir": "skills"
    }
  },
  "review_gate": {
    "deep_gate_lanes": [
      "general-purpose",
      "generalpurpose",
      "best-of-n-runner",
      "bestofnrunner",
      "review",
      "reviewer",
      "critic",
      "code-review"
    ]
  },
  "framework_commands": {
    "gsd": {
      "canonical_owner": "gsd",
      "skill_path": "skills/gsd/SKILL.md",
      "official_workflow": {
        "phases": [
          "exploration",
          "discussion",
          "planning",
          "execution",
          "verification",
          "delivery"
        ]
      },
      "implementation_bar": [
        "adversarial-first",
        "evidence-driven-verification",
        "one-breath-wave-execution",
        "multi-agent-with-lightweight-main-thread"
      ],
      "host_entrypoints": {
        "codex-cli": "/gsd",
        "cursor": "/gsd",
        "claude-code": "/gsd",
        "claude-desktop": "/gsd"
      },
      "entrypoint_modes": {
        "new-project": {
          "codex-cli": "/gsd-new-project",
          "cursor": "/gsd-new-project",
          "claude-code": "/gsd-new-project",
          "claude-desktop": "/gsd-new-project"
        },
        "discuss": {
          "codex-cli": "/gsd-discuss-phase",
          "cursor": "/gsd-discuss-phase",
          "claude-code": "/gsd-discuss-phase",
          "claude-desktop": "/gsd-discuss-phase"
        },
        "plan": {
          "codex-cli": "/gsd-plan-phase",
          "cursor": "/gsd-plan-phase",
          "claude-code": "/gsd-plan-phase",
          "claude-desktop": "/gsd-plan-phase"
        },
        "execute": {
          "codex-cli": "/gsd-execute-phase",
          "cursor": "/gsd-execute-phase",
          "claude-code": "/gsd-execute-phase",
          "claude-desktop": "/gsd-execute-phase"
        },
        "verify": {
          "codex-cli": "/gsd-verify-work",
          "cursor": "/gsd-verify-work",
          "claude-code": "/gsd-verify-work",
          "claude-desktop": "/gsd-verify-work"
        },
        "ship": {
          "codex-cli": "/gsd-ship",
          "cursor": "/gsd-ship",
          "claude-code": "/gsd-ship",
          "claude-desktop": "/gsd-ship"
        }
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/gsd",
          "/gsd-new-project",
          "/gsd-discuss-phase",
          "/gsd-plan-phase",
          "/gsd-execute-phase",
          "/gsd-verify-work",
          "/gsd-ship"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "repo-native",
        "description": "GSD lifecycle commands for exploration through ship with adversarial review."
      },
      "reroute_when_ambiguous": "deepinterview",
      "reroute_when_root_cause_unknown": "deepinterview",
      "goal_persistence": {
        "stdio_op": "framework_autopilot_goal",
        "artifact": "artifacts/current/<task_id>/GOAL_STATE.json",
        "execution_entrypoints": [
          "/gsd-execute-phase",
          "/gsd-verify-work",
          "/gsd-ship"
        ],
        "continuation_hook_leader": "router-rs GSD_GOAL_CONTINUE",
        "disable_hook_env": "ROUTER_RS_GSD_GOAL_CONTINUE_HOOK",
        "legacy_disable_hook_env": "ROUTER_RS_AUTOPILOT_DRIVE_HOOK",
        "rationale": "Macro goal drive is GSD execution-zone only. `/autopilot` retired. When drive_until_done and status=running, Cursor hooks inject GSD_GOAL_CONTINUE on Stop (and on hook-state lock failure paths that preserve continuity). Pre-execution GSD commands do not arm goal_required."
      }
    },
    "team": {
      "canonical_owner": "agent-swarm-orchestration",
      "skill_path": "skills/agent-swarm-orchestration/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/team",
        "cursor": "/team",
        "claude-code": "/team",
        "claude-desktop": "/team"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/team",
          "$team"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "framework-alias",
        "description": "Framework alias for explicit team orchestration entry only; not a visible skill or natural-language owner."
      }
    },
    "deepinterview": {
      "canonical_owner": "deepinterview",
      "skill_path": "skills/deepinterview/SKILL.md",
      "official_workflow": {
        "loop_rules": [
          "one-question-at-a-time",
          "target-weakest-clarity-dimension",
          "score-ambiguity-after-each-answer",
          "handoff-to-execution-only-below-threshold"
        ]
      },
      "implementation_bar": [
        "root-cause-first-when-unknown",
        "findings-first-with-severity-order",
        "verification-evidence-required",
        "fix-verify-loop-until-bounded-scope-clean"
      ],
      "local_adaptations": [
        "store interview progress in continuity artifacts and task-local bootstrap outputs",
        "use live repo evidence first for brownfield clarification before asking the user",
        "handoff into GSD execute-phase (`/gsd-execute-phase`) and rust-session-supervisor after clarity is sufficient"
      ],
      "review_lanes": [
        "deepinterview",
        "visual-review",
        "gh-address-comments",
        "gh-fix-ci",
        "sentry"
      ],
      "host_entrypoints": {
        "codex-cli": "/deepinterview",
        "cursor": "/deepinterview",
        "claude-code": "/deepinterview",
        "claude-desktop": "/deepinterview"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/deepinterview"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "repo-native",
        "description": "Native repo deep-interview workflow for evidence-first clarification and convergence review."
      }
    },
    "gitx": {
      "canonical_owner": "gitx",
      "skill_path": "skills/gitx/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/gitx",
        "cursor": "/gitx",
        "claude-code": "/gitx",
        "claude-desktop": "/gitx"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/gitx",
          "gitx"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "repo-native",
        "description": "Run the safe Git review-fix-tidy-commit-branch-merge-push workflow end to end."
      }
    },
    "update": {
      "canonical_owner": "update",
      "skill_path": "skills/update/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/update",
        "cursor": "/update",
        "claude-code": "/update",
        "claude-desktop": "/update"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/update"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "repo-native",
        "description": "Refresh key docs, git tracking, and stale/dead repo surfaces; includes framework generated-artifact checks when applicable."
      },
      "trigger_hints": [
        "/update",
        "更新关键文档",
        "科研文档更新",
        "git 跟踪文件",
        "死代码清理",
        "旧文档清理",
        "stale files",
        "dead code"
      ]
    }
  },
  "host_projections": {
    "codex-cli": {
      "profile_id": "codex_profile",
      "host_id": "codex-cli",
      "transport": "native-codex",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "user",
          "host_root": "codex",
          "relative": "config.toml"
        },
        {
          "scope": "project",
          "relative": ".codex/config.toml"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "project",
          "relative": ".codex/config.toml"
        }
      ],
      "session_supervisor_driver": "codex_driver",
      "resume_command_examples": [
        "codex resume --last",
        "codex resume <session_id>"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "batch_execution",
        "cron_execution",
        "ci_runner",
        "non_interactive_entrypoint",
        "external_session_supervisor",
        "rate_limit_auto_resume",
        "host_resume_entrypoint",
        "host_tmux_worker_management",
        "framework_alias_entrypoints"
      ]
    },
    "codex-app": {
      "profile_id": "codex_app_profile",
      "host_id": "codex-app",
      "transport": "codex-desktop-app",
      "harness_capability_exceptions": [
        {
          "cap": "closeout_evidence_hooks",
          "status": "unsupported",
          "rationale": "Codex desktop app thread host does not install the same file-projected hook bundle as codex-cli; closeout/evidence hooks are not materialized on this transport."
        },
        {
          "cap": "review_gate_router_observation",
          "status": "unsupported",
          "rationale": "Review gate router observation is not projected for codex-app; use codex-cli for hook-level REVIEW_GATE-style semantics."
        }
      ],
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [],
      "session_supervisor_driver": "unsupported",
      "session_supervisor_status": {
        "supported": false,
        "rationale": "Codex app thread execution is managed by the desktop host rather than external router-rs tmux supervision."
      },
      "resume_command_examples": [
        "Continue in the same Codex app thread"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract"
      ],
      "capabilities": [
        "artifact_contract",
        "thread_destination",
        "automation_hooks",
        "non_technical_ui",
        "framework_alias_entrypoints"
      ]
    },
    "cursor": {
      "profile_id": "cursor_profile",
      "host_id": "cursor",
      "transport": "cursor-agent",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "user",
          "host_root": "cursor",
          "relative": "settings.json"
        },
        {
          "scope": "project",
          "relative": ".cursor/settings.json"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "project",
          "relative": ".cursor/mcp.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "session_supervisor_status": {
        "supported": false,
        "rationale": "Cursor host does not expose external tmux session management or auto-resume. session_supervisor.rs::build_driver_command rejects non-codex drivers with `unknown_driver`. Long-running goals on Cursor must rely on in-session continuity artifacts (.supervisor_state.json, SESSION_SUMMARY.md, NEXT_ACTIONS.json, EVIDENCE_INDEX.json) instead of an external supervisor process."
      },
      "resume_command_examples": [
        "在 Cursor 中继续当前会话",
        "在同一工作区重新打开 Agent 对话"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "host_resume_entrypoint",
        "framework_alias_entrypoints",
        "post_edit_format_hooks"
      ]
    },
    "claude-code": {
      "profile_id": "claude_code_profile",
      "host_id": "claude-code",
      "transport": "anthropic-claude-code",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "project",
          "relative": ".claude/settings.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "resume_command_examples": [
        "Continue in Claude Code in this workspace"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints",
        "hard_gate_hooks"
      ]
    },
    "claude-desktop": {
      "profile_id": "claude_desktop_profile",
      "host_id": "claude-desktop",
      "transport": "mcp-stdio",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "project",
          "relative": ".claude/settings.json"
        },
        {
          "scope": "user",
          "host_root": "claude-desktop",
          "relative": "settings.json"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "user",
          "host_root": "claude-desktop",
          "relative": "mcp.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "resume_command_examples": [
        "Continue in the same Claude Desktop thread"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints"
      ],
      "harness_capability_exceptions": [
        {
          "cap": "closeout_evidence_hooks",
          "status": "unsupported",
          "rationale": "Claude Desktop MCP transport cannot install PreToolUse hard gates; evidence and checkpoints are advisory via MCP tools only."
        },
        {
          "cap": "review_gate_router_observation",
          "status": "unsupported",
          "rationale": "Desktop MCP has no subagent Start/Stop hook surface equivalent to Claude Code; use claude-code for hook-level REVIEW_GATE semantics."
        }
      ]
    }
  }
}
