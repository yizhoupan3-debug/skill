        "rationale": "Claude Code bridges session supervision through browser-mcp MCP tools. SubagentStart/Stop hooks provide native lifecycle events."
      },
      "resume_command_examples": [
        "Continue in Claude Code in this workspace"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints",
        "hard_gate_hooks"
      ],
      "managed_mcp_server_ids": [
        "router-rs-framework",
        "browser-mcp",
        "mcp-codegraph",
        "paperplain"
      ]
    },
    "opencode": {
      "profile_id": "opencode_profile",
      "host_id": "opencode",
      "transport": "opencode-cli",
      "context_files": [
        "AGENTS_OPENCODE.md"
      ],
      "settings_paths": [
        {
          "scope": "project",
          "relative": ".opencode/opencode.json"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "project",
          "relative": ".opencode/opencode.json"
        },
        {
          "scope": "user",
          "host_root": "opencode",
          "relative": "opencode.json",
          "notes": "Default: ~/.config/opencode/opencode.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "session_supervisor_status": {
        "supported": false,
        "rationale": "Opencode host does not expose external process supervision or auto-resume. Long-running goals on Opencode must rely on in-session continuity artifacts (.supervisor_state.json, SESSION_SUMMARY.md, NEXT_ACTIONS.json, EVIDENCE_INDEX.json) instead of an external supervisor process."
      },
      "resume_command_examples": [
        "Continue in the same Opencode session"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints"
      ],
      "managed_mcp_server_ids": [
        "router-rs-framework",
        "browser-mcp",
        "mcp-codegraph",
        "paperplain"
      ],
      "harness_capability_exceptions": [
        {
          "cap": "closeout_evidence_hooks",
          "status": "unsupported",
          "rationale": "Opencode MCP transport cannot install CLI-level PreToolUse hard gates; non-my-light closeout evidence may hard-block at MCP tool level (goal_state_manage complete / closeout_gate) when closeout unsatisfied—separate from review gate; my-light remains advisory."
        },
        {
          "cap": "review_gate_router_observation",
          "status": "unsupported",
          "rationale": "Opencode has no subagent Start/Stop hook surface; REVIEW_GATE router observation is unsupported—pairing review is skill-layer spawn-first (reviewer_lanes); Stop/session-end review is advisory-only via MCP closeout_gate / goal_state_manage (no REVIEW_GATE hard block on any host)."
        }
      ]
    },
