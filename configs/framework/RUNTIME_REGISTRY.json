  "host_projections": {
    "cursor": {
      "profile_id": "cursor_profile",
      "host_id": "cursor",
      "transport": "cursor-agent",
      "context_files": [
        "AGENTS_CURSOR.md"
      ],
      "settings_paths": [
        {
          "scope": "user",
          "host_root": "cursor",
          "relative": "settings.json"
        },
        {
          "scope": "project",
          "relative": ".cursor/settings.json"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "user",
          "host_root": "cursor",
          "relative": "mcp.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "session_supervisor_status": {
        "supported": false,
        "rationale": "Cursor host does not expose external process supervision or auto-resume. session_supervisor currently supports codex and claude-code drivers only. Long-running goals on Cursor must rely on in-session continuity artifacts (.supervisor_state.json, SESSION_SUMMARY.md, NEXT_ACTIONS.json, EVIDENCE_INDEX.json) instead of an external supervisor process."
      },
      "resume_command_examples": [
        "在 Cursor 中继续当前会话",
        "在同一工作区重新打开 Agent 对话"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "host_resume_entrypoint",
        "framework_alias_entrypoints"
      ],
      "managed_mcp_server_ids": [
        "router-rs-framework",
        "browser-mcp",
        "mcp-codegraph",
        "paperplain"
      ]
    },
    "claude-code": {
      "profile_id": "claude_code_profile",
      "host_id": "claude-code",
      "transport": "anthropic-claude-code",
      "context_files": [
        "AGENTS_CLAUDE.md"
      ],
      "settings_paths": [
        {
          "scope": "project",
          "relative": ".claude/settings.json"
        }
      ],
      "session_supervisor_driver": "mcp_bridge",
      "session_supervisor_status": {
        "supported": true,
