      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints"
      ],
      "managed_mcp_server_ids": [
        "router-rs-framework",
        "browser-mcp",
        "mcp-codegraph",
        "paperplain"
      ],
      "harness_capability_exceptions": [
        {
          "cap": "closeout_evidence_hooks",
          "status": "unsupported",
          "rationale": "Antigravity MCP transport cannot install CLI-level PreToolUse hard gates; non-my-light closeout evidence may hard-block at MCP tool execution when closeout unsatisfied—separate from review gate advisory."
        },
        {
          "cap": "review_gate_router_observation",
          "status": "unsupported",
          "rationale": "Antigravity MCP transport: no subagent Start/Stop hook surface; review relies on review-lanes/*.md and skill spawn-first; Stop review is advisory-only (MCP ADVISORY), not hard-blocked."
        }
      ]
    },
    "codex": {
