{
  "schema_version": "framework-runtime-registry-v1",
  "framework_core": {
    "authority": "rust",
    "source": "framework-root-native",
    "host_policy": "closed-set-explicit-projections"
  },
  "host_targets": {
    "policy": "shared-rust-core-explicit-host-projections",
    "supported": [
      "cursor",
      "claude-code",
      "opencode",
      "antigravity",
      "codex"
    ],
    "shared_system_source": "skills",
    "metadata": {
      "cursor": {
        "install_tool": "cursor",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": [
          "AGENTS_CURSOR.md",
          ".cursor/rules/*.mdc"
        ]
      },
      "claude-code": {
        "install_tool": "claude",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": [
          "AGENTS_CLAUDE.md",
          ".claude/rules/framework.md",
          ".claude/settings.json"
        ]
      },
      "antigravity": {
        "install_tool": "antigravity",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": [
          "AGENTS_ANTIGRAVITY.md",
          ".gemini/antigravity/rules/framework.md"
        ]
      },
      "opencode": {
        "install_tool": "opencode",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": ".opencode/opencode.json"
      },
      "codex": {
        "install_tool": "codex",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": "AGENTS_CODEX.md"
      }
    },
    "host_providers": {
      "cursor": {
        "cargo_feature": "host-cursor",
        "provider_module": "cursor_provider",
        "provider_type": "CursorHostProvider",
        "hooks_module": "cursor_hooks",
        "cli_hook_subcommand": "hook",
        "dispatch_fn": "dispatch_cursor_command"
      },
      "claude-code": {
        "cargo_feature": "host-claude-code",
        "provider_module": "claude_provider",
        "provider_type": "ClaudeHostProvider",
        "hooks_module": "claude_code_hooks",
        "cli_hook_subcommand": "hook",
        "dispatch_fn": "dispatch_claude_command"
      },
      "opencode": {
        "cargo_feature": "host-opencode",
        "provider_module": "opencode_provider",
        "provider_type": "OpencodeHostProvider",
        "hooks_module": "opencode_agent",
        "cli_agent_subcommand": "agent",
        "dispatch_fn": "dispatch_opencode_command"
      },
      "antigravity": {
        "cargo_feature": "host-antigravity",
        "provider_module": "antigravity_provider",
        "provider_type": "AntigravityHostProvider",
        "cli_agent_subcommand": "agent",
        "dispatch_fn": "dispatch_antigravity_command"
      },
      "codex": {
        "cargo_feature": "host-codex",
        "provider_module": "codex_provider",
        "provider_type": "CodexHostProvider",
        "hooks_module": "codex_hooks",
        "cli_hook_subcommand": "hook",
        "dispatch_fn": "dispatch_codex_command"
      }
    }
  },
  "workspace_bootstrap_defaults": {
    "skills": {
      "source_rel": "skills",
      "project_dir": "skills",
      "user_dir": "${CODEX_HOME}/skills",
      "source_dir": "skills"
    }
  },
  "review_gate": {
    "spawn_first_enabled": true,
    "spawn_first_nudge": "配对审稿：首轮工具前先 spawn 只读 reviewer（reviewer_lanes 闭集，fork_context=false）；主线程做调研须另开独立 reviewer，explore 不计入证据。细则 skills/code-review-deep/SKILL.md",
    "subagent_model_inherit_nudge": "子代理模型：继承主会话；Task 省略 model；禁止默认 claude/sonnet，除非主会话已选 Anthropic。地区不可用见 cursor.com/docs/account/regions",
    "subagent_model_inherit_nudge_by_host": {
      "cursor": "子代理模型（Cursor）：继承主会话；Task 省略 model；禁止默认 claude/sonnet，除非主会话已选 Anthropic。地区不可用见 cursor.com/docs/account/regions"
    },
    "spawn_first_nudge_template": "配对审稿（{host_label}）：首轮工具前先 spawn 只读 reviewer（reviewer_lanes 闭集，fork_context=false）；主线程调研须另开独立 reviewer，explore 不计入证据。细则 skills/code-review-deep/SKILL.md",
    "spawn_first_nudge_host_labels": {
      "claude-code": "Claude Code",
      "antigravity": "Antigravity",
      "codex": "Codex"
    },
    "spawn_first_nudge_by_host": {
      "cursor": "配对审稿（Cursor）：首轮工具前先 spawn 只读 reviewer（reviewer_lanes 闭集，fork_context=false）；主线程调研须另开独立 reviewer，explore 不计入证据；Task 省略 model、继承主会话，禁止默认 claude/sonnet。细则 skills/code-review-deep/SKILL.md",
      "opencode": "配对审稿（Opencode）：无 hook 注入；须主动 spawn 只读 reviewer（reviewer_lanes）并写 review-lanes/*.md。closeout/complete 在 MCP 工具层同 Claude Code。细则 skills/code-review-deep/SKILL.md"
    },
    "spawn_first_includes_model_inherit_by_host": {
      "cursor": true
    },
    "reviewer_lanes": [
      "general-purpose",
      "generalpurpose",
      "best-of-n-runner",
      "bestofnrunner",
      "deep-reviewer",
      "deepreviewer",
      "review",
      "reviewer",
      "critic",
      "code-review"
    ]
  },
  "lifecycle_profiles": {
    "my-light": {
      "disable_spawn_first_nudge": true
    }
  },
