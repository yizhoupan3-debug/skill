{
  "schema_version": "framework-runtime-registry-v1",
  "framework_core": {
    "authority": "rust",
    "source": "framework-root-native",
    "host_policy": "closed-set-explicit-projections",
    "authority_priority": "rust-primary",
    "acceleration_policy": "prefer-rust-when-implemented"
  },
  "host_targets": {
    "policy": "shared-rust-core-explicit-host-projections",
    "supported": [
      "codex-cli",
      "codex-app",
      "cursor",
      "claude-code",
      "claude-desktop",
      "antigravity"
    ],
    "shared_system_source": "skills",
    "metadata": {
      "codex-cli": {
        "install_tool": "codex",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": "AGENTS.md"
      },
      "cursor": {
        "install_tool": "cursor",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": [
          "AGENTS.md",
          ".cursor/rules/*.mdc"
        ]
      },
      "codex-app": {
        "install_tool": "codex",
        "projection_status": "implemented",
        "installable": false,
        "unsupported_reason": "Codex app is runtime-supported through the desktop thread host; it does not install file projections.",
        "host_entrypoints": "AGENTS.md"
      },
      "claude-code": {
        "install_tool": "claude",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": [
          "AGENTS.md",
          ".claude/rules/framework.md",
          ".claude/settings.json"
        ]
      },
      "claude-desktop": {
        "install_tool": "claude-desktop",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": [
          "AGENTS.md",
          ".claude/CLAUDE.md"
        ]
      },
      "antigravity": {
        "install_tool": "antigravity",
        "projection_status": "implemented",
        "installable": true,
        "default_framework_command": "implementx",
        "host_entrypoints": [
          "AGENTS.md",
          ".gemini/antigravity/rules/framework.md"
        ]
      }
    }
  },
  "workspace_bootstrap_defaults": {
    "skills": {
      "source_rel": "skills",
      "project_dir": "skills",
      "user_dir": "${CODEX_HOME}/skills",
      "source_dir": "skills"
    }
  },
  "review_gate": {
    "spawn_first_enabled": true,
    "spawn_first_nudge": "配对审稿：首轮工具前先 spawn 只读 reviewer（general-purpose/best-of-n-runner，fork_context=false）；主线程做调研须另开独立 reviewer，explore 不计入证据。细则 skills/code-review-deep/SKILL.md",
    "subagent_model_inherit_nudge": "子代理模型：继承主会话；Task 省略 model；禁止默认 claude/sonnet，除非主会话已选 Anthropic。地区不可用见 cursor.com/docs/account/regions",
    "subagent_model_inherit_nudge_by_host": {
      "cursor": "子代理模型（Cursor）：继承主会话；Task 省略 model；禁止默认 claude/sonnet，除非主会话已选 Anthropic。地区不可用见 cursor.com/docs/account/regions"
    },
    "spawn_first_nudge_by_host": {
      "cursor": "配对审稿（Cursor）：首轮工具前先 spawn 只读 reviewer（general-purpose/best-of-n-runner，fork_context=false）；主线程调研须另开独立 reviewer，explore 不计入证据；Task 省略 model、继承主会话，禁止默认 claude/sonnet。细则 skills/code-review-deep/SKILL.md",
      "codex-cli": "配对审稿（Codex）：首轮工具前先 spawn 只读 reviewer（general-purpose/best-of-n-runner，fork_context=false）；主线程调研须另开独立 reviewer，explore 不计入证据。细则 skills/code-review-deep/SKILL.md",
      "claude-code": "配对审稿（Claude Code）：首轮工具前先 spawn 只读 reviewer（general-purpose/best-of-n-runner 或 review/reviewer/critic/code-review，fork_context=false）；主线程调研须另开独立 reviewer，explore 不计入证据。细则 skills/code-review-deep/SKILL.md",
      "antigravity": "配对审稿（Antigravity）：首轮工具前先 spawn 只读 reviewer（general-purpose/best-of-n-runner 或 review/reviewer/critic/code-review，fork_context=false）；主线程调研须另开独立 reviewer，explore 不计入证据。细则 skills/code-review-deep/SKILL.md"
    },
    "spawn_first_includes_model_inherit_by_host": {
      "cursor": true
    },
    "deep_gate_lanes": [
      "general-purpose",
      "generalpurpose",
      "best-of-n-runner",
      "bestofnrunner",
      "deep-reviewer",
      "deepreviewer"
    ],
    "claude_reviewer_lanes": [
      "general-purpose",
      "generalpurpose",
      "best-of-n-runner",
      "bestofnrunner",
      "deep-reviewer",
      "deepreviewer",
      "review",
      "reviewer",
      "critic",
      "code-review"
    ]
  },
  "lifecycle_profiles": {
    "my-light": {
      "disable_review_gate_hard_block": true,
      "disable_spawn_first_nudge": true,
      "commands": [
        "discussx",
        "planx",
        "implementx",
        "verifyx"
      ]
    }
  },
  "framework_commands": {
    "discussx": {
      "canonical_owner": "discussx",
      "skill_path": "skills/discussx/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/discussx",
        "cursor": "/discussx",
        "claude-code": "/discussx",
        "claude-desktop": "/discussx",
        "antigravity": "/discussx"
      },
      "lineage": {
        "source": "repo-native",
        "description": "Personal lifecycle discuss (replaces gsd-new-project + discuss)."
      }
    },
    "planx": {
      "canonical_owner": "planx",
      "skill_path": "skills/planx/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/planx",
        "cursor": "/planx",
        "claude-code": "/planx",
        "claude-desktop": "/planx",
        "antigravity": "/planx"
      }
    },
    "implementx": {
      "canonical_owner": "implementx",
      "skill_path": "skills/implementx/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/implementx",
        "cursor": "/implementx",
        "claude-code": "/implementx",
        "claude-desktop": "/implementx",
        "antigravity": "/implementx"
      },
      "implementation_bar": [
        "one-breath-all-waves",
        "multi-agent-with-lightweight-main-thread"
      ],
      "goal_persistence": {
        "stdio_op": "framework_goal_drive",
        "artifact": "artifacts/current/<task_id>/GOAL_STATE.json",
        "execution_entrypoints": [
          "/implementx",
          "/verifyx"
        ],
        "continuation_hook_leader": "framework_goal_drive stdio + manual boards",
        "rationale": "Personal lifecycle: implementx runs all WAVE_STATE waves in one breath; verifyx closes with evidence+ship. Continuity exit: no hook GOAL_CONTINUE/RFV/digest; stdio goal drive and artifacts/current/<task_id>/ boards only."
      }
    },
    "verifyx": {
      "canonical_owner": "verifyx",
      "skill_path": "skills/verifyx/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/verifyx",
        "cursor": "/verifyx",
        "claude-code": "/verifyx",
        "claude-desktop": "/verifyx",
        "antigravity": "/verifyx"
      }
    },
    "team": {
      "canonical_owner": "agent-swarm-orchestration",
      "skill_path": "skills/agent-swarm-orchestration/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/team",
        "cursor": "/team",
        "claude-code": "/team",
        "claude-desktop": "/team",
        "antigravity": "/team"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/team",
          "$team"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "framework-alias",
        "description": "Framework alias for explicit team orchestration entry only; not a visible skill or natural-language owner."
      }
    },
    "deepinterview": {
      "canonical_owner": "deepinterview",
      "skill_path": "skills/deepinterview/SKILL.md",
      "official_workflow": {
        "loop_rules": [
          "one-question-at-a-time",
          "target-weakest-clarity-dimension",
          "score-ambiguity-after-each-answer",
          "handoff-to-execution-only-below-threshold"
        ]
      },
      "implementation_bar": [
        "root-cause-first-when-unknown",
        "findings-first-with-severity-order",
        "verification-evidence-required",
        "fix-verify-loop-until-bounded-scope-clean"
      ],
      "local_adaptations": [
        "store interview progress in continuity artifacts and task-local bootstrap outputs",
        "use live repo evidence first for brownfield clarification before asking the user",
        "handoff into My implement (`/implementx`) via `framework_goal_drive` after clarity is sufficient"
      ],
      "review_lanes": [
        "deepinterview",
        "visual-review",
        "gh-address-comments",
        "gh-fix-ci",
        "sentry"
      ],
      "host_entrypoints": {
        "codex-cli": "/deepinterview",
        "cursor": "/deepinterview",
        "claude-code": "/deepinterview",
        "claude-desktop": "/deepinterview",
        "antigravity": "/deepinterview"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/deepinterview"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "repo-native",
        "description": "Native repo deep-interview workflow for evidence-first clarification and convergence review."
      }
    },
    "gitx": {
      "canonical_owner": "gitx",
      "skill_path": "skills/gitx/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/gitx",
        "cursor": "/gitx",
        "claude-code": "/gitx",
        "claude-desktop": "/gitx",
        "antigravity": "/gitx"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/gitx",
          "gitx"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "repo-native",
        "description": "Run the safe Git review-fix-tidy-commit-branch-merge-push workflow end to end."
      }
    },
    "update": {
      "canonical_owner": "update",
      "skill_path": "skills/update/SKILL.md",
      "host_entrypoints": {
        "codex-cli": "/update",
        "cursor": "/update",
        "claude-code": "/update",
        "claude-desktop": "/update",
        "antigravity": "/update"
      },
      "interaction_invariants": {
        "requires_explicit_entrypoint": true,
        "explicit_entrypoints": [
          "/update"
        ],
        "implicit_route_policy": "never"
      },
      "lineage": {
        "source": "repo-native",
        "description": "Refresh key docs, git tracking, and stale/dead repo surfaces; includes framework generated-artifact checks when applicable."
      },
      "trigger_hints": [
        "/update",
        "更新关键文档",
        "科研文档更新",
        "git 跟踪文件",
        "死代码清理",
        "旧文档清理",
        "stale files",
        "dead code"
      ]
    }
  },
  "host_projections": {
    "codex-cli": {
      "profile_id": "codex_profile",
      "host_id": "codex-cli",
      "transport": "native-codex",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "user",
          "host_root": "codex",
          "relative": "config.toml"
        },
        {
          "scope": "project",
          "relative": ".codex/config.toml"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "project",
          "relative": ".codex/config.toml"
        }
      ],
      "session_supervisor_driver": "codex_driver",
      "resume_command_examples": [
        "codex resume --last",
        "codex resume <session_id>"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "batch_execution",
        "cron_execution",
        "ci_runner",
        "non_interactive_entrypoint",
        "external_session_supervisor",
        "rate_limit_auto_resume",
        "host_resume_entrypoint",
        "host_tmux_worker_management",
        "framework_alias_entrypoints"
      ]
    },
    "codex-app": {
      "profile_id": "codex_app_profile",
      "host_id": "codex-app",
      "transport": "codex-desktop-app",
      "harness_capability_exceptions": [
        {
          "cap": "closeout_evidence_hooks",
          "status": "unsupported",
          "rationale": "Codex desktop app thread host does not install the same file-projected hook bundle as codex-cli; closeout/evidence hooks are not materialized on this transport."
        },
        {
          "cap": "review_gate_router_observation",
          "status": "unsupported",
          "rationale": "Review gate router observation is not projected for codex-app; use codex-cli for hook-level REVIEW_GATE-style semantics."
        }
      ],
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [],
      "session_supervisor_driver": "unsupported",
      "session_supervisor_status": {
        "supported": false,
        "rationale": "Codex app thread execution is managed by the desktop host rather than external router-rs tmux supervision."
      },
      "resume_command_examples": [
        "Continue in the same Codex app thread"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract"
      ],
      "capabilities": [
        "artifact_contract",
        "thread_destination",
        "automation_hooks",
        "non_technical_ui",
        "framework_alias_entrypoints"
      ]
    },
    "cursor": {
      "profile_id": "cursor_profile",
      "host_id": "cursor",
      "transport": "cursor-agent",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "user",
          "host_root": "cursor",
          "relative": "settings.json"
        },
        {
          "scope": "project",
          "relative": ".cursor/settings.json"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "project",
          "relative": ".cursor/mcp.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "session_supervisor_status": {
        "supported": false,
        "rationale": "Cursor host does not expose external tmux session management or auto-resume. session_supervisor.rs::build_driver_command rejects non-codex drivers with `unknown_driver`. Long-running goals on Cursor must rely on in-session continuity artifacts (.supervisor_state.json, SESSION_SUMMARY.md, NEXT_ACTIONS.json, EVIDENCE_INDEX.json) instead of an external supervisor process."
      },
      "resume_command_examples": [
        "在 Cursor 中继续当前会话",
        "在同一工作区重新打开 Agent 对话"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "host_resume_entrypoint",
        "framework_alias_entrypoints"
      ]
    },
    "claude-code": {
      "profile_id": "claude_code_profile",
      "host_id": "claude-code",
      "transport": "anthropic-claude-code",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "project",
          "relative": ".claude/settings.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "resume_command_examples": [
        "Continue in Claude Code in this workspace"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract",
        "closeout_evidence_hooks",
        "review_gate_router_observation"
      ],
      "capabilities": [
        "artifact_contract",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints",
        "hard_gate_hooks"
      ]
    },
    "claude-desktop": {
      "profile_id": "claude_desktop_profile",
      "host_id": "claude-desktop",
      "transport": "mcp-stdio",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "project",
          "relative": ".claude/settings.json"
        },
        {
          "scope": "user",
          "host_root": "claude-desktop",
          "relative": "settings.json"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "user",
          "host_root": "claude-desktop",
          "relative": "mcp.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "resume_command_examples": [
        "Continue in the same Claude Desktop thread"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints"
      ],
      "harness_capability_exceptions": [
        {
          "cap": "closeout_evidence_hooks",
          "status": "unsupported",
          "rationale": "Claude Desktop MCP transport cannot install PreToolUse hard gates; evidence and checkpoints are advisory via MCP tools only."
        },
        {
          "cap": "review_gate_router_observation",
          "status": "unsupported",
          "rationale": "Desktop MCP has no subagent Start/Stop hook surface equivalent to Claude Code; use claude-code for hook-level REVIEW_GATE semantics."
        }
      ]
    },
    "antigravity": {
      "profile_id": "antigravity_profile",
      "host_id": "antigravity",
      "transport": "mcp-stdio",
      "context_files": [
        "AGENTS.md"
      ],
      "settings_paths": [
        {
          "scope": "project",
          "relative": ".gemini/settings.json"
        },
        {
          "scope": "user",
          "host_root": "antigravity",
          "relative": "settings.json"
        }
      ],
      "mcp_config_paths": [
        {
          "scope": "project",
          "relative": ".gemini/mcp.json"
        },
        {
          "scope": "user",
          "host_root": "antigravity",
          "relative": "mcp.json"
        }
      ],
      "session_supervisor_driver": "unsupported",
      "resume_command_examples": [
        "Continue in the same Antigravity thread"
      ],
      "harness_capabilities": [
        "hot_runtime_routing",
        "l2_continuity_contract"
      ],
      "capabilities": [
        "artifact_contract",
        "mcp_servers",
        "workspace_bootstrap",
        "interactive_agent_chat",
        "framework_alias_entrypoints"
      ],
      "harness_capability_exceptions": [
        {
          "cap": "closeout_evidence_hooks",
          "status": "unsupported",
          "rationale": "Antigravity MCP transport cannot install CLI-level PreToolUse hard gates; however, closeout verification is hard-blocked at the MCP tool execution level (goal_state_manage complete & closeout_gate)."
        },
        {
          "cap": "review_gate_router_observation",
          "status": "unsupported",
          "rationale": "Antigravity has no subagent Start/Stop hook surface equivalent to Claude Code; use claude-code for hook-level REVIEW_GATE semantics."
        }
      ]
    }
  }
}
