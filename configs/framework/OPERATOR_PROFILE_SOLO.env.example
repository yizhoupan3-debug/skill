# Solo / low-noise — matches router-rs **2026-05 subtraction defaults** (unset = off).
# Source from repo root:
#   cd "$(git rev-parse --show-toplevel)"
#   set -a; source configs/framework/OPERATOR_PROFILE_SOLO.env.example; set +a
#
# To restore legacy “always append evidence / Stop checkpoint” behavior, uncomment ENABLE_* below.

# --- Already default-off in code (no export needed) ---
# ROUTER_RS_CONTINUITY_POSTTOOL_EVIDENCE — unset = off; set 1 to enable PostTool → EVIDENCE_INDEX
# ROUTER_RS_CONTINUITY_STOP_CHECKPOINT — unset = off; set 1 to enable Stop checkpoint
# ROUTER_RS_DEPTH_COMPLIANCE_HINT — unset = off; strict depth mode also enables hint
# ROUTER_RS_CONTINUITY_WRITE_JOURNAL — unset = off; set 1 to write CONTINUITY_JOURNAL.json
# ROUTER_RS_TASK_STATE_AGGREGATE_AUTO — unset = off; use: router-rs framework task-state-aggregate-sync
# ROUTER_RS_CURSOR_SESSIONSTART_SUMMARY_MODE — default goal_only (digest with GOAL, no root SESSION_SUMMARY prefix)

# --- Optional further noise reduction ---
# export ROUTER_RS_HARNESS_OPERATOR_NUDGES=0
# export ROUTER_RS_GSD_GOAL_CONTINUE_HOOK=0
# export ROUTER_RS_RFV_LOOP_HOOK=0
# export ROUTER_RS_CURSOR_HOOK_SILENT=1
# export ROUTER_RS_CURSOR_SESSION_CLOSE_STYLE_NUDGE=0

# --- Explicitly re-enable legacy auto-write (opt-in) ---
# export ROUTER_RS_CONTINUITY_POSTTOOL_EVIDENCE=1
# export ROUTER_RS_CONTINUITY_STOP_CHECKPOINT=1
# export ROUTER_RS_CONTINUITY_WRITE_JOURNAL=1
# export ROUTER_RS_TASK_STATE_AGGREGATE_AUTO=1
# export ROUTER_RS_DEPTH_COMPLIANCE_HINT=1

# --- Do NOT disable unless you accept trade-offs ---
# ROUTER_RS_CURSOR_REVIEW_GATE_DISABLE=1  # emergency only
# ROUTER_RS_TASK_LEDGER_FLOCK=0           # network FS only
