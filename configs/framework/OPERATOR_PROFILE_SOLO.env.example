# Solo / low-noise — copy or: source configs/framework/OPERATOR_PROFILE_SOLO.env.example
# Semantics: docs/harness_architecture.md §5 (single source of truth).
# Does NOT disable hard stop shortcodes unless the variable explicitly says so.

# Optional: operator nudge text off (still subject to ROUTER_RS_OPERATOR_INJECT master gate)
# export ROUTER_RS_HARNESS_OPERATOR_NUDGES=0

# Reduce continuation nudges on Stop / related paths
# export ROUTER_RS_AUTOPILOT_DRIVE_HOOK=0
# export ROUTER_RS_RFV_LOOP_HOOK=0

# Fewer automatic continuity writes
# export ROUTER_RS_CONTINUITY_POSTTOOL_EVIDENCE=0
# export ROUTER_RS_CONTINUITY_STOP_CHECKPOINT=0

# Cursor: strip advisory after outbound size policy; hard lines kept
# export ROUTER_RS_CURSOR_HOOK_SILENT=1

# Cursor: soft session-close style line off
# export ROUTER_RS_CURSOR_SESSION_CLOSE_STYLE_NUDGE=0

# NOT recommended for default solo: disables Cursor review gate (emergency only)
# export ROUTER_RS_CURSOR_REVIEW_GATE_DISABLE=1
