{
  "schema_version": "runtime-provider-registry-v1",
  "source": "repo-local-runtime-contract",
  "plugin_abi_version": "skill-plugin-abi-v1",
  "policy": {
    "core_rule": "Rust control plane stays stable; providers are declared, versioned, and fail closed when unsupported.",
    "path_rule": "All provider paths are repo-relative or logical provider ids.",
    "compatibility_rule": "Provider additions are additive; breaking provider shape changes require a schema version bump."
  },
  "provider_inventory_policy": {
    "purpose": "document-only implementation inventory; not an execution ranking source",
    "live_execution_boundaries": [
      "Skill routing",
      "Host projection",
      "Runtime persistence/evidence"
    ]
  },
  "execution_providers": {
    "local_rust": {
      "status": "implemented",
      "delegate_family": "rust-cli",
      "result_envelope": "router-rs-execute-response-v1",
      "capabilities": [
        "dry_run",
        "live_primary",
        "trace_output"
      ],
      "priority": "primary",
      "acceleration_role": "rust-fast-path"
    },
    "host_tool": {
      "status": "declared",
      "delegate_family": "host-tool",
      "result_envelope": "router-rs-execute-response-v1",
      "capabilities": [
        "tool_call",
        "host_policy_gate"
      ],
      "priority": "fallback",
      "notes": "Host tool delegation for cases where Rust CLI cannot execute directly."
    },
    "remote_worker": {
      "status": "planned",
      "delegate_family": "remote-worker",
      "result_envelope": "router-rs-execute-response-v1",
      "capabilities": [
        "lease",
        "resume_cursor",
        "remote_trace"
      ],
      "notes": "Remote worker execution with lease management. Requires remote infrastructure."
    },
    "browser": {
      "status": "declared",
      "delegate_family": "browser-runtime",
      "result_envelope": "router-rs-execute-response-v1",
      "capabilities": [
        "attached_event_transport",
        "screenshot_evidence"
      ],
      "notes": "Browser-based execution with attached event transport. Requires browser automation infrastructure."
    },
    "mcp_tool": {
      "status": "declared",
      "delegate_family": "mcp-tool",
      "result_envelope": "router-rs-execute-response-v1",
      "capabilities": [
        "tool_schema",
        "resource_schema",
        "capability_negotiation"
      ],
      "notes": "MCP tool integration for external tool providers."
    }
  },
  "storage_providers": {
    "filesystem": {
      "status": "implemented",
      "capabilities": [
        "atomic_replace",
        "consistent_append",
        "remote_event_transport"
      ],
      "missing": [
        "compaction",
        "snapshot_delta",
        "sqlite_wal"
      ]
    },
    "sqlite": {
      "status": "implemented",
      "capabilities": [
        "atomic_replace",
        "consistent_append",
        "remote_event_transport",
        "compaction",
        "snapshot_delta",
        "sqlite_wal"
      ],
      "missing": []
    },
    "memory": {
      "status": "test_only",
      "capabilities": [
        "remote_event_transport"
      ],
      "missing": [
        "durable_append",
        "compaction",
        "snapshot_delta"
      ],
      "notes": "Memory provider is test-only. Production use requires durable_append capability."
    }
  },
  "trace_replay_providers": {
    "jsonl_stream": {
      "status": "implemented",
      "capabilities": [
        "cursor",
        "resume",
        "inspect"
      ]
    },
    "snapshot_delta": {
      "status": "implemented",
      "capabilities": [
        "snapshot",
        "delta_replay",
        "artifact_refs",
        "fail_closed_digest"
      ]
    },
    "human_intervention": {
      "status": "declared",
      "event_kinds": [
        "human.approval_requested",
        "human.approval_granted",
        "human.approval_rejected",
        "human.input_received"
      ],
      "capabilities": [
        "durable_pause",
        "resume_after_input",
        "audit_trail"
      ],
      "notes": "Human approval/pause/resume workflow for production deployments."
    }
  },
  "observability_providers": {
    "runtime_slo_loop": {
      "status": "declared",
      "signals": [
        "route_mismatch",
        "fallback_accept",
        "skill_load_failure",
        "eval_drift",
        "sandbox_timeout",
        "replay_resume"
      ],
      "outputs": [
        "dashboard_panel",
        "alert",
        "auto_tuning_recommendation"
      ],
      "notes": "Runtime SLO monitoring with route_mismatch, fallback_accept, and eval_drift signals. Outputs to dashboard/alert."
    }
  },
  "sandbox_profile_providers": {
    "read_only": {
      "status": "implemented",
      "capabilities": [
        "read_only"
      ]
    },
    "workspace": {
      "status": "implemented",
      "capabilities": [
        "read_only",
        "workspace_mutating"
      ]
    },
    "network": {
      "status": "declared",
      "capabilities": [
        "read_only",
        "networked"
      ],
      "notes": "Network-capable sandbox profile. Requires sandbox isolation configuration."
    },
    "high_risk": {
      "status": "declared",
      "capabilities": [
        "read_only",
        "workspace_mutating",
        "networked",
        "high_risk"
      ],
      "isolation": "dedicated-profile-required",
      "notes": "High-risk sandbox with dedicated profile isolation. Requires explicit approval workflow."
    }
  },
  "host_projection_providers": {
    "codex": {
      "status": "implemented",
      "projection": "codex_profile",
      "capabilities": [
        "context_files",
        "settings_paths",
        "mcp_config_paths",
        "resume_command_examples"
      ]
    },
    "cursor": {
      "status": "implemented",
      "projection": "cursor_profile",
      "capabilities": [
        "context_files",
        "settings_paths",
        "mcp_config_paths",
        "interactive_agent_chat"
      ]
    },
    "claude-code": {
      "status": "implemented",
      "projection": "claude_code_profile",
      "capabilities": [
        "context_files",
        "settings_paths",
        "hook_settings_paths",
        "hard_gate_hooks"
      ]
    },
    "antigravity": {
      "status": "implemented",
      "projection": "mcp_capability_profile",
      "capabilities": [
        "context_files",
        "mcp_config_paths"
      ],
      "notes": "Antigravity MCP host; hard closeout gate on goal_state_manage and closeout_gate tool execution."
    },
    "mcp": {
      "status": "declared",
      "projection": "mcp_capability_profile",
      "capabilities": [
        "tools",
        "resources",
        "prompts",
        "capability_negotiation"
      ],
      "notes": "Generic MCP host projection profile. Used when no specific host implementation exists."
    },
    "browser": {
      "status": "declared",
      "projection": "browser_runtime_profile",
      "capabilities": [
        "attached_event_transport",
        "screenshot_evidence",
        "local_target_navigation"
      ],
      "notes": "Browser runtime host projection with attached event transport."
    },
    "opencode": {
      "status": "implemented",
      "projection": "mcp_capability_profile",
      "capabilities": [
        "context_files",
        "mcp_config_paths"
      ],
      "notes": "OpenCode MCP capability profile."
    },
    "codex": {
      "status": "implemented",
      "projection": "codex_profile",
      "capabilities": [
        "context_files",
        "settings_paths",
        "mcp_config_paths",
        "hook_settings_paths",
        "external_session_supervisor",
        "batch_execution",
        "interactive_agent_chat"
      ],
      "notes": "Codex CLI host; session_supervisor_driver codex_driver; hooks via codex sync."
    }
  },
  "governance_eval_loop": {
    "status": "declared",
    "inputs": [
      "tests/routing_eval_cases.json",
      "skills/SKILL_HEALTH_MANIFEST.json",
      "skills/SKILL_ROUTING_RUNTIME_EXPLAIN.json",
      "configs/framework/HARNESS_BEHAVIORAL_EVAL_CASES.json",
      "configs/framework/HARNESS_FAILURE_TAXONOMY.json"
    ],
    "metrics": [
      "route_expected_owner_accuracy",
      "overlay_accuracy",
      "overtrigger_rate",
      "fallback_accept_rate",
      "token_cost",
      "latency",
      "recoverability",
      "trajectory_health",
      "closeout_integrity",
      "skill_contract_quality",
      "subagent_lane_integrity"
    ],
    "outputs": [
      "runtime_findings",
      "metadata_patch_candidates",
      "dashboard_summary",
      "failure_taxonomy_rollup"
    ],
    "notes": "Governance evaluation loop for routing accuracy, skill contract quality, and trajectory health monitoring. Currently documented but not executed."
  }
}
