{
  "_comment": "Managed by router-rs. Regenerate with `cargo run --manifest-path core/router-rs/Cargo.toml -- framework sync-entrypoints --host-id codex --repo-root \"$PWD\"`.",
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/hook.sh codex\" PostToolUse",
            "statusMessage": "Recording Codex tool evidence",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "shell|Bash|apply_patch|text_editor"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/hook.sh codex\" PreToolUse",
            "statusMessage": "Checking generated-surface guard",
            "timeout": 8,
            "type": "command"
          }
        ],
        "matcher": "shell|Bash|apply_patch|text_editor"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/hook.sh codex\" SessionStart",
            "statusMessage": "Loading Codex live state",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/hook.sh codex\" Stop",
            "statusMessage": "Enforcing Codex review gate",
            "timeout": 8,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/hook.sh codex\" SubagentStart",
            "statusMessage": "Recording Codex subagent start",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/hook.sh codex\" SubagentStop",
            "statusMessage": "Recording Codex subagent stop",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/hook.sh codex\" UserPromptSubmit",
            "statusMessage": "Loading Codex turn context",
            "timeout": 8,
            "type": "command"
          }
        ]
      }
    ]
  },
  "version": 1
}
