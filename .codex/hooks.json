{
  "_comment": "Managed by router-rs. Regenerate with `cargo run --manifest-path core/router-rs/Cargo.toml -- codex sync --repo-root \"$PWD\"`.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/codex-router-rs-hook.sh\" SessionStart",
            "statusMessage": "Loading Codex live state",
            "timeout": 3,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/codex-router-rs-hook.sh\" PreToolUse",
            "statusMessage": "Checking generated-surface guard",
            "timeout": 8,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/codex-router-rs-hook.sh\" UserPromptSubmit",
            "statusMessage": "Loading Codex turn context",
            "timeout": 8,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/codex-router-rs-hook.sh\" PostToolUse",
            "statusMessage": "Recording Codex tool evidence",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/codex-router-rs-hook.sh\" Stop",
            "statusMessage": "Enforcing Codex review gate",
            "timeout": 8,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/codex-router-rs-hook.sh\" SubagentStart",
            "statusMessage": "Recording Codex subagent start",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "/usr/bin/env bash \"${SKILL_FRAMEWORK_ROOT:-${CODEX_PROJECT_ROOT:-$(git rev-parse --show-toplevel 2>/dev/null || pwd)}}/configs/framework/codex-router-rs-hook.sh\" SubagentStop",
            "statusMessage": "Recording Codex subagent stop",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  },
  "version": 1
}
