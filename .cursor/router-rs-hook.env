# Cursor project hook defaults (sourced by configs/framework/cursor-router-rs-hook.sh).
# Memory / hook-frequency tuning for this workspace.
#
# Hook timeouts are in .cursor/hooks.json (gate events default 20s; postToolUse=20 review multiset).
# If postToolUse hooks stall, check disk I/O and .cursor/hook-state size before raising timeout.
ROUTER_RS_CONTINUITY_POSTTOOL_EVIDENCE=0
ROUTER_RS_CURSOR_CARGO_CHECK_SYNC=0
ROUTER_RS_CURSOR_KILL_STALE_TERMINALS=0
# 5 subtracted hook events default to dispatch no-op (handlers retained). Set to 1 only when re-registering those events in hooks.json:
# ROUTER_RS_CURSOR_HOOK_LEGACY_SUBTRACTED_EVENTS=1
