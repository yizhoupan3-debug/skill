#!/bin/sh
set -eu

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

NEEDS_SKILL_REFRESH=0
for path in $STAGED_FILES; do
    case "$path" in
        skills/*/SKILL.md|skills/.system/*/SKILL.md|skills/_archived/gsd-lifecycle/*/SKILL.md|skills/discussx/SKILL.md|skills/planx/SKILL.md|skills/implementx/SKILL.md|skills/verifyx/SKILL.md|configs/framework/FRAMEWORK_SURFACE_POLICY.json)
            NEEDS_SKILL_REFRESH=1
            ;;
    esac
done

if [ "$NEEDS_SKILL_REFRESH" != "1" ]; then
    exit 0
fi

LOG_FILE=$(mktemp "${TMPDIR:-/tmp}/skill-pre-commit.XXXXXX")
trap 'rm -f "$LOG_FILE"' EXIT

if ! cargo run --quiet --manifest-path scripts/router-rs/Cargo.toml -- \
  framework skills refresh --framework-root "$PWD" --write >"$LOG_FILE" 2>&1; then
    echo "[pre-commit] framework skills refresh failed; rerun:"
    echo "  cargo run --manifest-path scripts/router-rs/Cargo.toml -- framework skills refresh --framework-root \"\$PWD\" --write"
    tail -n 40 "$LOG_FILE"
    exit 1
fi

if ! git diff --quiet -- skills/SKILL_TIERS.json; then
    echo "[pre-commit] router-rs refreshed skills/SKILL_TIERS.json."
    echo "Stage the file, then commit again:"
    echo "  git add skills/SKILL_TIERS.json"
    exit 1
fi
